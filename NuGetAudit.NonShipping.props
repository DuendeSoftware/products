<Project>
    <!--
        NuGet audit suppressions for NON-SHIPPING projects only (tests, samples, migrations).
        Imported from test/, samples/ and migrations/ Directory.Build.props.
        Never import this file from src/: vulnerable dependencies of shipped packages must be
        fixed by upgrading to a patched version instead.
    -->
    <ItemGroup>
        <!-- Duende.AccessTokenManagement < 3.2.0 (no patched 2.x release, see Directory.Build.targets) -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-qxj7-2x7w-3mpp" />
        <!-- Duende.IdentityServer 6.3.6 / 7.0.0-preview.2 used by tests and the sample IdentityServer -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-ff4q-64jc-gx98" />
        <!-- System.IdentityModel.Tokens.Jwt / Microsoft.IdentityModel.JsonWebTokens 7.0.3 (sample APIs) -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-59j7-ghrg-fj52" />
        <!-- System.Text.Json 6.0.0 / 8.0.0 -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-8g4q-xg66-9fp4" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-hh2w-p6rv-4g7w" />
        <!-- Microsoft.AspNetCore.Components 6.0.9 (Blazor sample) -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-3fx3-85r4-8j3w" />
        <!-- Legacy test dependencies (Newtonsoft.Json 9.0.1, System.Net.Http 4.3.0, System.Text.RegularExpressions 4.3.0, Microsoft.NETCore.Jit 1.0.2) -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-5crp-9r3c-p9vr" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-7jgj-8wvc-jh57" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-cmhx-cq75-c4mj" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-xcvr-qv8h-m7xw" />
        <!-- EF Core provider dependencies in samples/migrations (SqlClient, SQLite, System.Drawing.Common, Azure.Identity, System.Formats.Asn1) -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-98g6-xh36-x2p7" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rxg9-xrhp-64gj" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-5mfx-4wcx-rv27" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-m5vv-6r4h-3vj9" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wvxc-855f-jvrv" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-447r-wph3-92pm" />
    </ItemGroup>
</Project>
