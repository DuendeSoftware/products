@page
@model TotpAuthentication.Pages.Manage2FAModel
@{
    ViewData["Title"] = "Manage Two-Factor Authentication";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="form-container">
            <h2 class="mb-4 brand-title text-center">Manage Two-Factor Authentication</h2>

            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <div class="alert alert-success" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@Model.StatusMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                </div>
            }

            <div class="alert alert-success mb-4" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-shield-check fs-2 me-3"></i>
                    <div>
                        <h5 class="alert-heading mb-1">Two-Factor Authentication is Enabled</h5>
                        <p class="mb-0">Your account is protected with an authenticator app.</p>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-bold">
                    <i class="bi bi-key me-2"></i>Recovery Codes
                </div>
                <div class="card-body">
                    @if (Model.RecoveryCodesLeft == 0)
                    {
                        <div class="alert alert-danger mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>You have no recovery codes left.</strong>
                            <p class="mb-0 mt-2">You must generate new recovery codes before you can log in with a recovery code.</p>
                        </div>
                    }
                    else if (Model.RecoveryCodesLeft == 1)
                    {
                        <div class="alert alert-warning mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong>You have 1 recovery code left.</strong>
                            <p class="mb-0 mt-2">You can generate new recovery codes to maintain access to your account.</p>
                        </div>
                    }
                    else if (Model.RecoveryCodesLeft <= 3)
                    {
                        <div class="alert alert-warning mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong>You have @Model.RecoveryCodesLeft recovery codes left.</strong>
                            <p class="mb-0 mt-2">Consider generating new recovery codes to maintain access to your account.</p>
                        </div>
                    }
                    else
                    {
                        <p class="mb-3">
                            <i class="bi bi-info-circle me-2"></i>
                            You have <strong>@Model.RecoveryCodesLeft recovery codes</strong> remaining.
                        </p>
                    }

                    <p class="text-muted small mb-3">
                        Recovery codes can be used to access your account if you lose access to your authenticator app.
                        Keep them in a safe place.
                    </p>

                    <form method="post" asp-page-handler="GenerateRecoveryCodes" class="d-inline">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-arrow-clockwise me-2"></i>Generate New Recovery Codes
                        </button>
                    </form>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-bold">
                    <i class="bi bi-shield-slash me-2"></i>Authenticator App
                </div>
                <div class="card-body">
                    <p class="mb-3">
                        If you want to change or reset your authenticator app, you can do so here.
                        This will invalidate your current authenticator setup.
                    </p>

                    <form method="post" asp-page-handler="ResetAuthenticator"
                          onsubmit="return confirm('This will disable your authenticator app until you reconfigure it. Are you sure?');">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-arrow-counterclockwise me-2"></i>Reset Authenticator App
                        </button>
                    </form>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-bold bg-danger text-white">
                    <i class="bi bi-shield-x me-2"></i>Disable Two-Factor Authentication
                </div>
                <div class="card-body">
                    <div class="alert alert-warning mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Warning:</strong> Disabling 2FA will make your account less secure.
                    </div>

                    <p class="mb-3">
                        Disabling two-factor authentication will remove the additional security layer from your account.
                        You can re-enable it at any time.
                    </p>

                    <form method="post" asp-page-handler="Disable2FA"
                          onsubmit="return confirm('Are you sure you want to disable two-factor authentication? This will make your account less secure.');">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-shield-x me-2"></i>Disable Two-Factor Authentication
                        </button>
                    </form>
                </div>
            </div>

            <div class="d-grid">
                <a asp-page="/Index" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-left me-2"></i>Back to Home
                </a>
            </div>
        </div>
    </div>
</div>
