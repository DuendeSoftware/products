@page
@model LoginModel
@{
  ViewData["Title"] = "Log in";
}

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="form-container">
      <h2 class="mb-4 brand-title text-center">Log in</h2>

      @if (Model.ErrorMessages.Count > 0)
      {
        <div class="alert alert-danger mb-4" role="alert">
          @foreach (var error in Model.ErrorMessages)
          {
            <div><i class="bi bi-exclamation-triangle-fill me-2"></i>@error</div>
          }
        </div>
      }

      <div id="passkey-status" class="alert d-none" role="alert"></div>

      <form method="post">
        <input type="hidden" asp-for="ReturnUrl"/>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors alert alert-danger" role="alert"></div>

        <div class="mb-4">
          <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
          <input asp-for="Email" type="email" class="form-control form-control-lg"
                 placeholder="Enter your email address" required autofocus autocomplete="email"/>
          <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="d-grid gap-2">
          <button type="submit" class="btn btn-primary btn-lg">
            <i class="bi bi-envelope-check me-2"></i>Send one-time password (OTP)
          </button>

          <button type="button" id="passkey-discoverable-login-btn" class="btn btn-outline-primary btn-lg">
            <i class="bi bi-fingerprint me-2"></i>Use passkey with discoverable credentials
          </button>
        </div>

      </form>

      <form method="post" asp-page-handler="ToggleFidoMds" class="mt-4">
        <input type="hidden" name="enabled" value="@(!Model.FidoMdsEnabled ? "true" : "false")"/>
        <div class="card shadow-sm">
          <div class="card-body d-flex align-items-center justify-content-between py-3">
            <div>
              <strong><i class="bi bi-shield-check me-2"></i>FIDO MDS Trust Policy</strong>
              <div class="form-text mt-0">
                When enabled, only authenticators listed in the FIDO Metadata Service with certification level &ge; L2
                are accepted during passkey registration.
              </div>
            </div>
            <div class="form-check form-switch mb-0">
              <input class="form-check-input" type="checkbox" role="switch" id="fidoMdsToggle"
                     @(Model.FidoMdsEnabled ? "checked" : "") onchange="this.form.submit()"/>
              <label class="form-check-label" for="fidoMdsToggle">
                @(Model.FidoMdsEnabled ? "Enabled" : "Disabled")
              </label>
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

@section Scripts {
  <script src="/passkeys/js"></script>
  <script src="~/js/passkeys-ui.js"></script>
}
