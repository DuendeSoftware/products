@page
@model SpecialAccessModel
@{
  ViewData["Title"] = "Special Access";
}

<div class="row justify-content-center mt-4">
  <div class="col-md-8">
    <div class="platform-hero text-center">
      <h1>MFA Step Up</h1>
      <p class="lead m-0">
        To reach this page, you had to complete an MFA step-up challenge.
        This simulates a scenario where users must re-authenticate with MFA to access sensitive information or perform high-risk actions.
      </p>
    </div>
  </div>
</div>
