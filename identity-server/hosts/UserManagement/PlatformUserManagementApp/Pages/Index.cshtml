@page
@model PlatformUserManagementApp.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="platform-hero text-center">
            <img src="~/duende-white.svg" alt="Duende Software" style="height:48px; filter: invert(1) brightness(0.3);" class="mb-3" />
            <h1 class="brand-title">Platform User Management</h1>
            <p class="lead text-muted">
                Manage users with the Duende Platform's SCIM-based user profile store.
            </p>
            <a asp-page="/Users/Index" class="btn btn-primary btn-lg me-2">
                <i class="bi bi-people me-2"></i>Manage Users
            </a>
            <a asp-page="/Import/Index" class="btn btn-outline-secondary btn-lg">
                <i class="bi bi-upload me-2"></i>Import from ASP.NET Identity
            </a>
        </div>

        @if (Model.ErrorMessages.Count > 0)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-4" role="alert">
                @foreach (var error in Model.ErrorMessages)
                {
                    <div><i class="bi bi-exclamation-triangle-fill me-2"></i>@error</div>
                }
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show mt-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Passkeys -->
        <div class="card shadow-sm mt-4">
            <div class="card-header text-white fw-bold" style="background-color: #6a3d9a;">
                <i class="bi bi-key me-2"></i>Passkeys
            </div>
            <div class="card-body">
                <p class="text-muted mb-4">
                    Passkeys allow you to sign in securely without an OTP using biometrics or your device's security features.
                </p>

                <div id="passkey-status" class="alert d-none" role="alert"></div>

                @if (Model.Passkeys.Any())
                {
                    <div class="table-responsive mb-3">
                        <table class="table table-hover">
                            <thead>
                            <tr>
                                <th>Name</th>
                                <th>Created</th>
                                <th class="text-end"></th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var passkey in Model.Passkeys)
                            {
                                <tr>
                                    <td>
                                        <i class="bi bi-fingerprint me-2 text-primary"></i>
                                        @passkey.Name
                                    </td>
                                    <td>@passkey.CreatedAt.ToString("u")</td>
                                    <td class="text-end">
                                        <form method="post" asp-page-handler="RemovePasskey" class="d-inline">
                                            <input type="hidden" name="credentialId" value="@passkey.CredentialId.ToBase64String()" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Are you sure you want to remove this passkey?');">
                                                <i class="bi bi-trash"></i> Remove
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }

                <button type="button" id="add-passkey-btn" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Add passkey
                </button>
            </div>
        </div>
    </div>
</div>

<div id="passkeyNameModal" class="modal-overlay" style="display: none;">
    <div class="modal-dialog">
        <div class="modal-content card shadow" style="background-color: white;">
            <div class="card-header text-white fw-bold" style="background-color: #6a3d9a;">
                <i class="bi bi-key me-2"></i>Name your passkey
            </div>
            <div class="card-body" style="background-color: white;">
                <p class="text-muted">Give your passkey a friendly name to help you identify it later.</p>
                <label for="passkeyNameInput" class="form-label fw-bold">Name</label>
                <input type="text" class="form-control" id="passkeyNameInput" maxlength="255" />
            </div>
            <div class="card-footer d-flex gap-2 justify-content-end" style="background-color: white;">
                <button type="button" class="btn btn-secondary" id="cancelPasskeyBtn">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmPasskeyBtn">
                    <i class="bi bi-fingerprint me-1"></i>Continue
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/passkeys/js"></script>
    <script src="~/js/passkeys-ui.js"></script>
}
