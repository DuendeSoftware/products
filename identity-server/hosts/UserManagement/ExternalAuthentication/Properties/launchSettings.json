{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,

      // This URL has to be https://localhost:5001 because that's what's configured
      // in google cloud for the callback url. Also, google cloud doesn't accept
      // a *.dev.localhost url. 
      "applicationUrl": "https://localhost:5001",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}
