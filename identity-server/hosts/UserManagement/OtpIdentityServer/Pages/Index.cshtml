@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="persona-hero text-center">
  <h1>Welcome to Duende IdentityServer</h1>
  <p class="lead m-0">
    A demonstration of Duende Software's Persona product combined with IdentityServer.
  </p>
</div>

<div class="mt-4">

  @if (User.Identity?.IsAuthenticated == true)
  {
    <div class="card shadow-sm mb-4">
      <div class="card-body text-center py-4">
        <h5 class="card-title mb-3">
          <i class="bi bi-person-check-fill text-success me-2"></i>You are signed in
        </h5>
        <p class="text-muted mb-4">Welcome back, @User.Identity.Name!</p>

        <div class="d-flex gap-2 justify-content-center">
          <a asp-page="/Account/Profile" class="btn btn-primary">
            <i class="bi bi-person-circle me-2"></i>Manage Profile
          </a>
          <a asp-page="/Account/Logout" class="btn btn-outline-primary">
            <i class="bi bi-box-arrow-right me-2"></i>Sign Out
          </a>
        </div>
      </div>
    </div>

    @if (User.Claims.Any())
    {
      <h3 class="mt-4 mb-3">Authentication Cookie</h3>
      <div class="row g-3">
        <div class="col-md-6">
          <div class="card shadow-sm h-100">
            <div class="card-header text-white fw-bold" style="background-color: #6a3d9a;">
              Claims
            </div>
            <div class="card-body">
              @foreach (var claim in User.Claims)
              {
                <div class="mb-3">
                  <div class="fw-bold">@claim.Type.Split('/').Last()</div>
                  <div>@claim.Value</div>
                </div>
              }
            </div>
          </div>
        </div>
      </div>
    }
  }
  else
  {
    <div class="card shadow-sm">
      <div class="card-body text-center py-5">
        <h5 class="card-title mb-3">You are not signed in</h5>
        <p class="text-muted mb-4">Sign in to view your profile and claims</p>

        <div>
          <a asp-page="/Account/Login" class="btn btn-primary btn-lg">
            <i class="bi bi-envelope-check me-2"></i>Sign In with Email OTP
          </a>
        </div>
      </div>
    </div>
  }
</div>
