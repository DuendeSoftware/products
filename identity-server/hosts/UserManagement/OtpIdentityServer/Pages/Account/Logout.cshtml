@page
@model LogoutModel
@{
    ViewData["Title"] = "Logout";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="form-container text-center">
            <div class="mb-4">
                <i class="bi bi-check-circle text-success" style="font-size: 4rem;"></i>
            </div>
            <h2 class="mb-3 brand-title">Signed Out</h2>
            <p class="text-muted mb-4">You have been successfully signed out.</p>
            <div>
                <a asp-page="/Login" class="btn btn-primary btn-lg">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In Again
                </a>
            </div>
        </div>
    </div>
</div>
