@page
@model AspNetIdentityApp.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Sign out";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="form-container text-center">
            <h2 class="mb-3 brand-title">Sign out</h2>
            <p class="text-muted mb-4">Are you sure you want to sign out?</p>
            <form method="post">
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-danger btn-lg">
                        <i class="bi bi-box-arrow-right me-2"></i>Yes, sign out
                    </button>
                    <a asp-page="/Index" class="btn btn-outline-secondary btn-lg">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
