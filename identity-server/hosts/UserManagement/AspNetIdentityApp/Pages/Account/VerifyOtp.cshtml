@page
@model AspNetIdentityApp.Pages.Account.VerifyOtpModel
@{
  ViewData["Title"] = "Verify OTP";
}

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="form-container">
      <h2 class="mb-2 brand-title text-center">Verify your email</h2>
      <p class="text-muted text-center mb-4">
        We sent a 6-digit code to your email address. Enter it below to continue.
      </p>

      @if (Model.ErrorMessages.Count > 0)
      {
        <div class="alert alert-danger mb-4" role="alert">
          @foreach (var error in Model.ErrorMessages)
          {
            <div><i class="bi bi-exclamation-triangle-fill me-2"></i>@error</div>
          }
        </div>
      }

      <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors alert alert-danger" role="alert"></div>

        <div class="mb-4">
          <label asp-for="Otp" class="form-label fw-semibold">One-time password</label>
          <input asp-for="Otp" type="text" class="form-control form-control-lg text-center"
                 placeholder="000000" maxlength="6" required autofocus autocomplete="one-time-code"
                 inputmode="numeric" pattern="[0-9]{6}" />
          <span asp-validation-for="Otp" class="text-danger"></span>
        </div>

        <div class="d-grid">
          <button type="submit" class="btn btn-primary btn-lg">
            <i class="bi bi-shield-check me-2"></i>Verify
          </button>
        </div>
      </form>

      <div class="mt-3 text-center">
        <a asp-page="/Account/Login" class="text-muted small">
          <i class="bi bi-arrow-left me-1"></i>Back to login
        </a>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
