@page
@model IdentityServerTemplate.Pages.Admin.ApiScopes.IndexModel

<div class="container-fluid mb-4 px-0">

    <header class="pb-3 mb-4 border-bottom">
        <h1 class=" fw-bold">
            <i class="bi bi-shield-lock text-brand"></i>
            API Scopes
        </h1>
        <span class="text-muted">
            API scopes represent the permissions or access levels that can be requested and granted to access protected API resources. They define the boundaries of what actions clients can perform with the API.
        </span>
    </header>

    <div class="d-flex justify-content-end align-items-end p-2 flex-nowrap">

        <!-- Actions: keep dropdown + form together, no wrap -->
        <div class="d-flex align-items-center flex-nowrap gap-2">

            <a class="btn btn-outline-primary" asp-page="/Admin/ApiScopes/New">
                New Scope
            </a>

            <!-- Filter/Search form -->
            <form role="search" class="row g-2 flex-grow-1 align-items-end">
                <div class="col-auto">
                    <input class="form-control me-2"
                           type="text"
                           id="filter"
                           name="filter"
                           placeholder="Filter"
                           value="@Model.Filter" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-filter"></i>
                        Filter
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Display Name</th>
            <th><span class="d-none">Actions</span></th>
        </tr>
    </thead>

    <tbody class="table-group-divider">
        @foreach (var scope in Model.Scopes)
        {
            <tr>
                <td class="align-middle fw-bold">@scope.Name</td>
                <td class="align-middle">
                    @if (string.IsNullOrWhiteSpace(scope.DisplayName))
                    {
                        <i class='text-muted fst-italic'>None</i>
                    }
                    else
                    {
                        @scope.DisplayName
                    }
                </td>
                <td class="text-end">
                    <a asp-page="/Admin/ApiScopes/Edit"
                       class="btn btn-link text-primary m-0 p-0"
                       asp-route-id="@scope.Name">
                        <i class="bi bi-pencil-square"></i>
                        <span class="d-none">Edit</span>
                    </a>

                    <button type="submit"
                            class="btn btn-link text-danger m-0 p-0"
                            form="delete-form"
                            name="Input.Button"
                            value="delete"
                            asp-page="/Admin/ApiScopes/Delete"
                            asp-route-id="@scope.Name"
                            data-confirm="Are you sure you want to delete this API Scope?">
                        <i class="bi bi-trash"></i>
                        <span class="d-none">Delete</span>
                    </button>

                </td>
            </tr>
        }
        @if (!Model.Scopes.Any())
        {
            <tr>
                <td colspan="3" class="text-center p-4">
                    <div class="alert alert-light text-center mb-0">
                       You do not have any API Scopes configured.<br />
                       Click "New Scope" above to begin adding a new API Scope.
                    </div>
                </td>
            </tr>
        }
    </tbody>

</table>

<form id="delete-form" method="post" class="d-none"></form>
