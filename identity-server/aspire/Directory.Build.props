<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..\'))" />
  <PropertyGroup>
    <AnalysisMode>None</AnalysisMode>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <!-- Aspire hosts are dev/test only and not shipped: Aspire.Hosting/Aspire.Hosting.AppHost 13.2.4 GHSA-f7vh-h5g3-7jrh and Aspire.Dashboard.Sdk 13.2.4 GHSA-4g86-54fm-h9h8 (patched 13.6.5). -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-f7vh-h5g3-7jrh" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-4g86-54fm-h9h8" />
  </ItemGroup>
</Project>
