<?xml version="1.0" encoding="utf-8"?>
<Project>

  <Import Project="../src.props" />

  <PropertyGroup>
    <PackageTags>OAuth 2.0;OpenID Connect;Security;BFF;IdentityServer;ASP.NET Core;SPA;Blazor</PackageTags>
    <Product>Duende BFF</Product>
    <MinVerTagPrefix>bff-</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>2.3</MinVerMinimumMajorMinor>
    <AssemblyName>Duende.$(MSBuildProjectName)</AssemblyName>
    <IsBffProject>true</IsBffProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- 10.0.111 is the lowest version patched for GHSA-23fw-v26w-5fgq (Microsoft.Build.Tasks.Git 8.0.0). Scoped to BFF so the shared root Directory.Packages.props stays unchanged. -->
    <PackageReference Update="Microsoft.SourceLink.GitHub" VersionOverride="10.0.111" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Pin C# 13: with SDK 10.0.4xx, `latest` is C# 14, whose first-class spans change array.Contains binding in EF expression trees. -->
    <LangVersion>13</LangVersion>
  </PropertyGroup>
</Project>
