<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- This line is needed because:

    Aspire needs a single target framework
      (until this is resolved: https://github.com/dotnet/aspire/issues/2962)

    When you add <TargetFramework>net9.0</TargetFramework> then aspire thinks there are more than
    one framework. But this causes a problem for the Directory.Packages.props file.

    In the Directory.Packages.props where we check for $(TargetFramework) == 'net9.0',
    which is ONLY set if you use <TargetFramework>net9.0</TargetFramework> in the csproj file, not
    if you set <TargetFramework>.

    Now normally it's not recommended to set both, however, since this is only for samples, AND
    we do need this check, we're setting it here as well.

      -->
    <TargetFramework>net10.0</TargetFramework>

  </PropertyGroup>

  <Import Project="../hosts_and_clients.props" />
  <!-- Sample/test-only projects (not shipped): suppress known advisories in transitive packages from Aspire/OpenTelemetry/test tooling. AngleSharp GHSA-pgww-w46g-26qg; MessagePack 2.5.192 (11 advisories); OpenTelemetry.Api GHSA-g94r-2vxg-569j; OpenTelemetry.Exporter.OpenTelemetryProtocol GHSA-4625-4j76-fww9; SQLitePCLRaw.lib.e_sqlite3 GHSA-2m69-gcr7-jv3q (no patched 2.x release). -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-pgww-w46g-26qg" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2f33-pr97-265q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2x83-8g95-xh59" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-cj9g-3mj2-g8vv" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-cxmj-83gh-fp49" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-hv8m-jj95-wg3x" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-q2h6-ghwm-5qm8" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-qhmf-xw27-6rqr" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v72x-2h86-7f8m" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-vh6j-jc39-fggf" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-w567-gjr2-hm5j" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wfr3-xj75-pfwh" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-g94r-2vxg-569j" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-4625-4j76-fww9" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>
</Project>
