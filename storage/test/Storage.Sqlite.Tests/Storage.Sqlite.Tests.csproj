<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Duende.Storage.Sqlite.Tests</AssemblyName>
    <RootNamespace>Duende.Storage.Sqlite</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Storage\Storage.csproj" />
    <ProjectReference Include="..\..\src\Storage.Sqlite\Storage.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SharedIntegrationTests\**\*.cs" Link="SharedIntegrationTests\%(Filename)%(Extension)" Exclude="..\SharedIntegrationTests\StoreLinkDeterministicConcurrencyTests.cs;..\SharedIntegrationTests\IConcurrencyTestFixture.cs" />
  </ItemGroup>

  <!--
    StoreLinkDeterministicConcurrencyTests needs a second, concurrently blocked connection/transaction
    (a row lock the engine's own connection waits on, or a real deadlock) to make the entity delete's
    single repeat and the whole-operation deadlock retry deterministic. SQLite has a single writer
    (SQLITE_BUSY serializes instead of blocking/deadlocking), so neither schedule is reachable here:
    excluded above rather than wired with a fixture that can never satisfy it.
  -->
</Project>
